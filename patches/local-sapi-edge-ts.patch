+/** Путь к tts.ps1: env-переопределение, DSH_HOME, затем ~/.dsh. */
+function sapiScriptPath(): string | undefined {
+  const candidates: string[] = [];
+  if (process.env.DSH_PET_SAPI_SCRIPT) candidates.push(process.env.DSH_PET_SAPI_SCRIPT);
+  if (process.env.DSH_HOME) candidates.push(join(process.env.DSH_HOME, 'dsh-pet', 'sapi', 'tts.ps1'));
+  candidates.push(join(homedir(), '.dsh', 'dsh-pet', 'sapi', 'tts.ps1'));
+  return candidates.find((file) => existsSync(file));
+}
+
+/** Синтез через SAPI: текст в файл, powershell рисует WAV, результат кладём в target. */
+async function synthesizeSapi(input: { text: string; target: string }): Promise<void> {
+  const script = sapiScriptPath();
+  if (!script) throw new Error('sapi: script not found');
+  const textFile = input.target + '.txt';
+  const staging = input.target + '.part';
+  await writeFile(textFile, input.text, 'utf8');
+  try {
+    await new Promise<void>((resolvePromise, rejectPromise) => {
+      const child = spawn(
+        'powershell.exe',
+        [
+          '-NoProfile',
+          '-NonInteractive',
+          '-STA',
+          '-ExecutionPolicy',
+          'Bypass',
+          '-File',
+          script,
+          '-TextFile',
+          textFile,
+          '-OutFile',
+          staging,
+        ],
+        { windowsHide: true },
+      );
+      const timer = setTimeout(() => {
+        child.kill();
+        rejectPromise(new Error('sapi: timeout'));
+      }, SAPI_TIMEOUT_MS);
+      child.on('error', (error) => {
+        clearTimeout(timer);
+        rejectPromise(error);
+      });
+      child.on('exit', (code) => {
+        clearTimeout(timer);
+        if (code === 0) resolvePromise();
+        else rejectPromise(new Error('sapi: exit ' + String(code)));
+      });
+    });
+    const info = await stat(staging);
+    if (!info.size) throw new Error('sapi: empty audio');
+    await rename(staging, input.target);
+  } finally {
+    await rm(textFile, { force: true }).catch(() => undefined);
+    await rm(staging, { force: true }).catch(() => undefined);
+  }
+}
